{
	"version": "2.0.0",
	"options": {
		"env": {
			"VIRTUAL_ENV": "${env:HOME}/zephyrproject/.venv",
			"ZEPHYR_BASE": "${workspaceFolder}/zephyr"
		}
	},
	"tasks": [
		{
			"hide": false,
			"label": "west_setup",
			"type": "shell",
			"command": "bash",
			"args": [
				"-c",
				"unset ZEPHYR_BASE && cd ${workspaceFolder}/manifest && ${VIRTUAL_ENV}/bin/west init -l && ${VIRTUAL_ENV}/bin/west update"
			],
			"problemMatcher": []
		},
		{
			"hide": false,
			"label": "west_clean",
			"type": "shell",
			"command": "bash",
			"args": [
				"-c",
				"rm -rf ${workspaceFolder}/.west ${workspaceFolder}/zephyr ${workspaceFolder}/modules ${workspaceFolder}/app/build"
			],
			"problemMatcher": []
		},
		{
			"hide": false,
			"label": "app_build",
			"type": "shell",
			"group": "build",
			"command": "bash",
			"args": [
				"-c",
				"unset ZEPHYR_BASE && ${VIRTUAL_ENV}/bin/west build -b hfn_f411ce -p -s app -d app/build -- -DBOARD_ROOT=${workspaceFolder} -DDTC_OVERLAY_FILE=${workspaceFolder}/app/boards/hfn_f411ce.overlay"
			],
			"problemMatcher": ["$gcc"]
		},
		{
			"hide": false,
			"label": "app_flash_jlink",
			"type": "shell",
			"command": "bash",
			"args": [
				"-c",
				"${VIRTUAL_ENV}/bin/west flash -d app/build --runner jlink"
			],
			"problemMatcher": ["$gcc"]
		},
		{
			"hide": false,
			"label": "app_flash_stlink",
			"type": "shell",
			"command": "bash",
			"args": [
				"-c",
				"${VIRTUAL_ENV}/bin/west flash -d app/build --runner stm32cubeprogrammer"
			],
			"problemMatcher": ["$gcc"]
		}
	]
}